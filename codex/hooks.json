{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash '__HOME__/.codex/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/opt/homebrew/lib/node_modules/cxstatusline/dist/cxstatusline.js' hook",
            "timeout": 10,
            "statusMessage": "cxstatusline: checking Codex version"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "__HOME__/.claude/hooks/blocked-fetch-hint.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
