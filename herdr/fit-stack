#!/usr/bin/env bash
# Keeps a new-worktree.sh --stack layout (Claude | browser over changes) fitted to its screen: the
# browser sized for a 16:10 page. Fits at once, then again whenever the space's size changes (another
# screen, a resized window, zoom); a dragged divider stays until then. Ends when the space closes.
#   fit-stack app <claude terminal> <browser terminal> <claude pane> <browser pane> <changes pane>
#   fit-stack old <claude pane> <browser pane>              (old Herdr)
#   fit-stack weights <pane> <weight>...                    (herdr-app: set split shares once)
#   fit-stack --check                                       (self-test of the sizing)
set -uo pipefail

# fit <cols> <rows> <cell width/height> <rows of pane header and browser toolbar>: the right column's
# share of the width and the browser's share of its height. The browser takes 65% of the height
# (changes 35%); where that needs more than 70% of the width (a laptop), the column stays at 70% and
# the browser is shorter.
fit() { awk -v c="$1" -v r="$2" -v a="$3" -v k="$4" 'BEGIN { h = 0.65; w = 1.6 * (h * r - k) / a / c
  if (w > 0.7) { w = 0.7; h = (w * c * a / 1.6 + k) / r }
  if (w < 0.3) w = 0.3
  printf "%.2f %.2f\n", w, h }'; }
calc() { awk "BEGIN { printf \"%.2f\", $1 }"; }

# herdr-app has no pane-size command: set weights in its layout document in herdr-core, with the
# version just read (retried if the app wrote first). "^<pane>" sizes the split that holds the pane.
rpc() { printf '%s\n' "$1" | hc connect; }
weights() {
  local spec doc _
  spec=$(printf '%s\n' "$@" | jq -Rn '[inputs] | [range(0; length; 2) as $i | {(.[$i]): (.[$i + 1] | tonumber)}] | add')
  for _ in 1 2 3 4 5; do
    doc=$(rpc '{"jsonrpc":"2.0","id":1,"method":"doc.get","params":{"name":"herdr-app"}}')
    rpc "$(jq -c --argjson s "$spec" '{jsonrpc: "2.0", id: 2, method: "doc.set", params: {name: "herdr-app",
      version: .result.version, value: (.result.value | walk(if type == "object" and has("id") then
        (if $s[.id] then .size = {weight: $s[.id]} else . end)
        | (if has("children") then reduce (.children[].id) as $c (.; if $s["^" + $c] then .size = {weight: $s["^" + $c]} else . end) else . end)
      else . end))}}' <<<"$doc")" | jq -e .result >/dev/null && return
  done
  return 1
}

case "${1:-}" in
  --check)
    # ultrawide and laptop windows, in herdr-app's cells (0.395) and old Herdr's in Ghostty (0.43)
    [ "$(fit 262 42 0.395 2.5)" = "0.38 0.65" ] && [ "$(fit 170 46 0.395 2.5)" = "0.65 0.65" ] &&
      [ "$(fit 212 40 0.43 1.5)" = "0.43 0.65" ] && [ "$(fit 134 43 0.43 1.5)" = "0.70 0.62" ] && echo ok ;;

  weights) shift; weights "$@" ;;

  app)
    claude=$2 browser=$3 root=$4 bpane=$5 cpane=$6 last=
    # shortcut: herdr-app's cell is 8.5x21.5 pt (JetBrains Mono 14) and its pane header plus the
    # browser toolbar take 2.5 rows (measured); measure again if the font changes.
    while [ "$(hc get "$claude" --json 2>/dev/null | jq -r .state)" = live ]; do
      # Claude's terminal spans the height; with the browser's, the width (in cells).
      read -r cc cr < <(hc get "$claude" --json | jq -r '"\(.cols) \(.rows)"')
      bc=$(hc get "$browser" --json | jq -r .cols)
      cols=$((cc + bc))
      # 200x120 is herdr-core's size before the app lays a terminal out; a column or two is rounding.
      if [ "$cc $cr" != "200 120" ] && [ "$bc" != 200 ] &&
        { [ -z "$last" ] || [ "$cr" != "${last#* }" ] || [ $((cols - ${last% *})) -gt 2 ] || [ $((${last% *} - cols)) -gt 2 ]; }; then
        read -r w h < <(fit "$cols" "$cr" 0.395 2.5)
        weights "$root" "$(calc "1 - $w")" "^$bpane" "$w" "$bpane" "$h" "$cpane" "$(calc "1 - $h")"
        sleep 2  # let the app lay it out, then remember the size it settled at
        last="$(($(hc get "$claude" --json | jq -r .cols) + $(hc get "$browser" --json | jq -r .cols))) $cr"
      fi
      sleep 2
    done ;;

  old)
    root=$2 browser=$3 last=
    # shortcut: Ghostty's cell is about 0.43 as wide as tall (JetBrains Mono 14) and the browser
    # toolbar about 1.5 rows (estimated, not measured); measure again if that changes.
    while layout=$(herdr pane layout --pane "$root" 2>/dev/null) && jq -e .result <<<"$layout" >/dev/null; do
      area=$(jq -r '.result.layout.area | "\(.width) \(.height)"' <<<"$layout")
      if [ "$area" != "$last" ]; then
        read -r w h < <(fit $area 0.43 1.5)
        # Split ratios are the share of the first pane: Claude's across, the browser's down.
        for s in "right $root $(calc "1 - $w")" "down $browser $h"; do
          set -- $s
          cur=$(jq -r --arg d "$1" '[.result.layout.splits[] | select(.direction == $d) | .ratio][0]' <<<"$layout")
          d=$(calc "$3 - $cur")
          case "$d" in
            0.00 | -0.00) ;;
            -*) herdr pane resize --pane "$2" --direction "$([ "$1" = right ] && echo left || echo up)" --amount "${d#-}" >/dev/null ;;
            *) herdr pane resize --pane "$2" --direction "$1" --amount "$d" >/dev/null ;;
          esac
        done
        last=$area
      fi
      sleep 2
    done ;;

  *) sed -n '2,9p' "$0" >&2; exit 2 ;;
esac
