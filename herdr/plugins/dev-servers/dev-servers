#!/usr/bin/env bash
# Dev servers (TCP listeners) started from folders under ~/Repos.
#   dev-servers list              popup: every such server; Enter stops the selected ones (Tab marks several)
#   dev-servers reap [--dry-run]  stop detached servers (no terminal) in a wt worktree (<repo>/.claude/worktrees/<name>)
#                                 that no Herdr pane has open, logging to ~/.local/state/herdr-dev-servers.log;
#                                 the plugin runs this when a pane, tab or workspace closes
set -euo pipefail
PATH="/opt/homebrew/bin:/usr/sbin:$PATH"
WT_RE='^(.*/\.claude/worktrees/[^/]+)'
LOG="${XDG_STATE_HOME:-$HOME/.local/state}/herdr-dev-servers.log"

# pid<TAB>port<TAB>command<TAB>cwd for each TCP listener whose working folder is under ~/Repos.
listeners() {
  local l
  l=$(lsof -nP -iTCP -sTCP:LISTEN -Fpcn 2>/dev/null |
    awk '/^p/{p=substr($0,2)} /^c/{c=substr($0,2)} /^n/{n=$0; sub(/.*:/,"",n); print p"\t"n"\t"c}' | sort -u)
  [ -n "$l" ] || return 0
  # One lsof call for every listener's working folder, joined back on pid.
  awk -F'\t' -v repos="$HOME/Repos/" 'NR==FNR {cwd[$1]=$2; next} index(cwd[$1], repos)==1 {print $0"\t"cwd[$1]}' \
    <(lsof -a -d cwd -p "$(cut -f1 <<<"$l" | sort -u | paste -sd, -)" -Fpn 2>/dev/null | awk '/^p/{p=substr($0,2)} /^n/{print p"\t"substr($0,2)}') \
    <(printf '%s\n' "$l")
}

# Worktree folders that have a Herdr pane open (launch or live folder). Fails when Herdr has no panes,
# so a server starting up or an unreachable socket never looks like "everything closed".
open_worktrees() {
  local panes
  if [ -n "${HC_TERMINAL_ID:-}" ]; then  # herdr-app: every herdr-core terminal
    panes=$(hc ls --json | jq -r '.terminals[].address' | while read -r t; do hc get "$t" --json; done |
      jq -r '.cwd, .foreground.cwd // empty') || return 1
  else
    panes=$(herdr pane list | jq -r '.result.panes[] | .cwd, .foreground_cwd // empty') || return 1
  fi
  [ -n "$panes" ] || return 1
  sed -nE "s#$WT_RE.*#\1#p" <<<"$panes" | sort -u
}

has_tty() { [ "$(ps -o tty= -p "$1" | tr -d ' ')" != "??" ]; }

reap() {
  local open dry=${1:-}
  open=$(open_worktrees) || exit 0
  listeners | while IFS=$'\t' read -r pid port cmd cwd; do
    [[ $cwd =~ $WT_RE ]] || continue
    grep -qxF "${BASH_REMATCH[1]}" <<<"$open" && continue
    # A server in a terminal (an editor's, or a Herdr pane) ends with that terminal; only detached ones leak.
    has_tty "$pid" && continue
    if [ "$dry" = --dry-run ]; then
      echo "would stop $cmd :$port (pid $pid) in ${BASH_REMATCH[1]##*/}"
    else
      kill "$pid" 2>/dev/null || true
      echo "$(date '+%F %T') stopped $cmd :$port (pid $pid) in ${BASH_REMATCH[1]##*/}" | tee -a "$LOG"
    fi
  done
}

rows() {
  local open
  open=$(open_worktrees || true)
  listeners | while IFS=$'\t' read -r pid port cmd cwd; do
    if [[ $cwd =~ $WT_RE ]]; then
      where=${BASH_REMATCH[1]##*/}
      if grep -qxF "${BASH_REMATCH[1]}" <<<"$open"; then state=open
      elif has_tty "$pid"; then state="closed, in a terminal: left alone"
      else state="closed: stops on next close"; fi
    else
      where=${cwd#"$HOME"/Repos/} state="not a worktree: never auto-stopped"
    fi
    printf '%-6s %-34.34s %-10.10s %-7s %s\n' "$port" "$where" "$cmd" "$pid" "$state"
  done | sort -k2,2 -k1,1n
}

list() {
  local picked
  while true; do
    picked=$(rows | fzf --multi --reverse --no-sort \
      --header=$'Enter stops the selected servers · Tab marks several · Esc closes\nPORT   WORKTREE                           PROCESS    PID     HERDR' \
      --prompt='Filter > ') || { [ $? -eq 130 ] && exit 0; continue; }  # Esc closes; no match reloads
    awk '{print $4}' <<<"$picked" | xargs kill 2>/dev/null || true
    sleep 1
  done
}

case ${1:-list} in
  list) list ;;
  reap) reap "${2:-}" ;;
  *) echo "usage: dev-servers [list | reap [--dry-run]]" >&2; exit 2 ;;
esac
