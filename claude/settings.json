{
  "env": {
    "CLAUDE_CODE_ENABLE_FUNCTION_HOOKS": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "deny": [
      "SendFeedback"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__HOME__/.claude/turn-timer.sh start"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__HOME__/.claude/turn-timer.sh stop"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '__HOME__/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "__HOME__/.claude/hooks/hc-session-record.py",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__HOME__/.claude/hooks/hc-session-record.py",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "__HOME__/.claude/statusline.sh",
    "padding": 1,
    "refreshInterval": 15
  },
  "enabledPlugins": {
    "swift-lsp@claude-plugins-official": true,
    "codex@openai-codex": true,
    "terminal-browser@terminal-browser": true,
    "worktrunk@worktrunk": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "terminal-browser": {
      "source": {
        "source": "github",
        "repo": "zenbu-labs/terminal-browser"
      }
    },
    "worktrunk": {
      "source": {
        "source": "github",
        "repo": "max-sixty/worktrunk"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "feedbackDrafts": "off",
  "theme": "dark",
  "deniedMcpServers": [
    {
      "serverName": "claude.ai Asana"
    },
    {
      "serverName": "claude.ai Box"
    },
    {
      "serverName": "claude.ai Canva"
    },
    {
      "serverName": "claude.ai Figma"
    },
    {
      "serverName": "claude.ai Gmail"
    },
    {
      "serverName": "claude.ai Google Calendar"
    },
    {
      "serverName": "claude.ai Google Docs"
    },
    {
      "serverName": "claude.ai Google Drive"
    },
    {
      "serverName": "claude.ai Google Sheets"
    },
    {
      "serverName": "claude.ai Google Slides"
    },
    {
      "serverName": "claude.ai HubSpot"
    },
    {
      "serverName": "claude.ai Intercom"
    },
    {
      "serverName": "claude.ai Linear"
    },
    {
      "serverName": "claude.ai Meetings"
    },
    {
      "serverName": "claude.ai Claude Data"
    }
  ],
  "skillOverrides": {
    "anthropic-skills:docx": "name-only",
    "anthropic-skills:pdf": "name-only",
    "anthropic-skills:pptx": "name-only",
    "anthropic-skills:docs": "name-only",
    "anthropic-skills:google-workspace": "name-only",
    "anthropic-skills:morning": "name-only",
    "anthropic-skills:import-memory": "name-only",
    "anthropic-skills:skill-creator": "name-only"
  }
}
