# =============================================================================
# Completions
# =============================================================================

autoload bashcompinit && bashcompinit

# A full compinit re-audits every directory in $fpath and rewrites the dump
# (~650ms). Do that at most once a day; the rest of the time load the existing
# dump with -C, which skips the audit and the rebuild. Run `compinit` by hand
# (or delete ~/.zcompdump) after installing something that ships completions.
#
# The freshness test has to be a glob in an array assignment: `[[ ]]` does no
# filename generation, so testing the pattern there always looks non-empty and
# silently pins us to -C. Bare `(...)` qualifiers are used rather than `(#q...)`
# because the latter needs EXTENDED_GLOB, which this config does not set.
autoload -Uz compinit
() {
  local -a fresh_dump=( $HOME/.zcompdump(N.mh-24) )
  if (( $#fresh_dump )); then
    compinit -C
  else
    compinit
    # compinit only rewrites the dump when the completions actually changed, so
    # without this the mtime stays old and every later shell takes the slow
    # path forever. Touching it restarts the 24h clock.
    touch $HOME/.zcompdump
  fi
}

