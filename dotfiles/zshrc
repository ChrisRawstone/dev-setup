# =============================================================================
# NVM (Node Version Manager) — lazy
# =============================================================================
#
# Sourcing nvm.sh the normal way runs nvm_auto, i.e. `nvm use default`, on every
# shell start. On this machine that costs ~5.2s: nvm is 160KB of POSIX shell
# that resolves the alias chain through dozens of forked subshells and then
# spawns `npm config get prefix` (~450ms on its own). It was ~85% of startup.
#
# Instead: put the default version's bin dir on PATH with plain file reads (no
# forks), and defer nvm.sh itself until the first actual `nvm` call.

export NVM_DIR="$HOME/.nvm"

# Follow the `default` alias chain (default -> lts/* -> lts/krypton -> v24.19.0)
# using builtin reads. $(<file) is a zsh optimisation that does not fork.
() {
  local v=default i
  for i in {1..10}; do
    [[ -f $NVM_DIR/alias/$v ]] || break
    v=$(<$NVM_DIR/alias/$v)
  done
  [[ -n $v ]] || return

  local bin=$NVM_DIR/versions/node/$v/bin
  if [[ ! -d $bin ]]; then
    # partial version (e.g. "24") -> highest installed match, as `nvm use` does
    local -a matches=($NVM_DIR/versions/node/${v}*(/Nn))
    (( $#matches )) && bin=${matches[-1]}/bin
  fi
  [[ -d $bin ]] && path=($bin $path)
}

# First `nvm ...` call pays for loading nvm.sh; --no-use keeps it from
# re-running the auto-activation we just did by hand.
nvm() {
  unfunction nvm
  [ -s "/opt/homebrew/opt/nvm/nvm.sh" ] && \. "/opt/homebrew/opt/nvm/nvm.sh" --no-use
  [ -s "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm" ] && \. "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm"
  nvm "$@"
}

