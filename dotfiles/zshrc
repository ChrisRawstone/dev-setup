# =============================================================================
# Stale VIRTUAL_ENV guard (must be after all PATH manipulation)
# =============================================================================
# GUI apps (Cursor/VS Code) inherit VIRTUAL_ENV from whatever shell launched
# them and hand it to every integrated terminal. Each new shell rebuilds PATH
# from scratch, so the marker outlives the activation: the prompt claims a venv
# is active while `which python` finds nothing. Drop the marker unless the venv
# actually belongs to where we are; repair PATH when it does.
if [[ -n $VIRTUAL_ENV ]]; then
  if [[ ! -x $VIRTUAL_ENV/bin/python ]]; then
    unset VIRTUAL_ENV                                     # venv no longer exists
  elif [[ $VIRTUAL_ENV == "$PWD"/* || $PWD == "${VIRTUAL_ENV:h}"(|/*) ]]; then
    [[ :$PATH: == *:$VIRTUAL_ENV/bin:* ]] ||
      export PATH="$VIRTUAL_ENV/bin:$PATH"                # ours, but off PATH
  else
    unset VIRTUAL_ENV                                     # leaked from elsewhere
  fi
fi
export PATH="$HOME/.local/bin:$PATH"
