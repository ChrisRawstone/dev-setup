# claude: Run Claude Code from a trusted scratch dir when launched from $HOME
# Claude Code never persists trust for the home directory, so a bare `claude`
# in ~ re-prompts every time. Redirect only an exact-$HOME cwd; any project
# directory (including one under ~) runs in place.
export CLAUDE_HOME_DIR="$HOME/scratch"
claude() {
  if [[ "$PWD" == "$HOME" ]]; then
    mkdir -p "$CLAUDE_HOME_DIR"
    (cd "$CLAUDE_HOME_DIR" && command claude "$@")
  else
    command claude "$@"
  fi
}

