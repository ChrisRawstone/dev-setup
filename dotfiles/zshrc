# No heavy frameworks - just the essentials

# =============================================================================
# Helpers
# =============================================================================

# eval_cached <cache-name> <command> [args...]
# Many tools ship their shell integration as `eval "$(tool init zsh)"`, which
# costs a process spawn on every single shell start. Cache the generated
# snippet and source that instead. The cache is regenerated whenever the tool's
# binary is newer than the cache, so upgrades are picked up on the next shell.
# Delete ~/.cache/zsh-init to force a rebuild.
eval_cached() {
  local name=$1 bin
  shift
  # accept either an absolute path or a bare command name
  if [[ $1 == */* ]]; then bin=$1; else bin=${commands[$1]}; fi
  [[ -n $bin ]] || return 1
  # drop the command name and invoke the resolved binary directly, so a shell
  # function of the same name (e.g. wt's own wrapper) can't intercept this
  shift

  local dir=${XDG_CACHE_HOME:-$HOME/.cache}/zsh-init
  local cache=$dir/$name.zsh

  if [[ ! -s $cache || $bin -nt $cache ]]; then
    mkdir -p $dir
    if $bin "$@" > $cache.tmp$$ 2>/dev/null; then
      mv -f $cache.tmp$$ $cache
    else
      rm -f $cache.tmp$$
      return 1
    fi
  fi

  source $cache
}

